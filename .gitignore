# Raw datasets are large; never commit them
data/raw/*
!data/raw/.gitkeep
data/processed/*.csv
data/processed/*.parquet
!data/processed/.gitkeep

# Model artifacts
*.pkl
*.joblib
models/*.json

# Notebook prototype caches (regenerated by running the notebooks in order)
notebooks/proto_cache.npz
notebooks/proto_xgb.json

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
.venv/
*.egg-info/
